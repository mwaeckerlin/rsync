{
  "name": "@mwaeckerlin/rsync",
  "version": "1.3.2",
  "description": "Headless rsync images: synchronise volumes once, or whenever inotify reports a change",
  "private": true,
  "scripts": {
    "build": "docker compose build",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "start:daemon": "docker compose up -d --build --force-recreate --remove-orphans",
    "start:dev": "docker compose up --build --force-recreate --remove-orphans",
    "stop": "docker compose down",
    "deploy": "docker compose push",
    "test": "npm run test:docs && npm run test:image && npm run test:e2e",
    "test:docs": "bash tests/docs-contract.sh",
    "test:image": "npm run build && bash tests/image-contract.sh",
    "test:e2e": "bash tests/run-e2e.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mwaeckerlin/rsync.git"
  },
  "author": "Marc Wäckerlin",
  "license": "LGPL-3.0-or-later"
}
